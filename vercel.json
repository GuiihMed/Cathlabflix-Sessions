{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/new",
      "destination": "/new.html"
    },
    {
      "source": "/new/player",
      "destination": "/new/player.html"
    },
    {
      "source": "/new/post",
      "destination": "/new/post.html"
    },
    {
      "source": "/new/posts",
      "destination": "/new/posts.html"
    },
    {
      "source": "/new/solaci",
      "destination": "/new/solaci.html"
    },
    {
      "source": "/new/aulas-solaci",
      "destination": "/new/aulas-solaci.html"
    },
    {
      "source": "/new/busca",
      "destination": "/new/busca.html"
    },
    {
      "source": "/new/congressos",
      "destination": "/new/congressos.html"
    },
    {
      "source": "/congressos",
      "destination": "/new/congressos.html"
    },
    {
      "source": "/new/tct",
      "destination": "/new/tct.html"
    },
    {
      "source": "/tct",
      "destination": "/new/tct.html"
    },
    {
      "source": "/busca",
      "destination": "/new/busca.html"
    },
    {
      "source": "/novo",
      "destination": "/new.html"
    },
    {
      "source": "/solaci/gravação",
      "destination": "/solaci/gravacao"
    },
    {
      "source": "/solaci/grava%C3%A7%C3%A3o",
      "destination": "/solaci/gravacao"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
