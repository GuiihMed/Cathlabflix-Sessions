{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CathlabFlixWebinarItem",
  "description": "Schema oficial para itens de webinares da plataforma CathlabFlix by SBHCI",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "shortTitle",
    "date",
    "dateISO",
    "dateFormatted",
    "category",
    "categorySlug",
    "badge",
    "duration",
    "thumbnail",
    "vimeoId",
    "videoEmbedUrl",
    "infographicUrl",
    "pdfUrl",
    "notebookLm",
    "audios",
    "summary",
    "fullReport",
    "quiz"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "ID único do webinar em minúsculas (usado no parâmetro ?id=...)",
      "example": "magic-touch"
    },
    "slug": {
      "type": "string",
      "description": "Slug amigável para SEO e rotas",
      "example": "15-07-26-lacamento-magic-touch"
    },
    "title": {
      "type": "string",
      "description": "Título científico completo",
      "example": "Lançamento Magic Touch - A nova era dos balões farmacológicos"
    },
    "shortTitle": {
      "type": "string",
      "description": "Título resumido (máx 35 caracteres) para breadcrumbs e botões",
      "example": "Lançamento Magic Touch"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{2}/\\d{2}/\\d{4}$",
      "description": "Data no formato DD/MM/AAAA",
      "example": "15/07/2026"
    },
    "dateISO": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Data no formato ISO AAAA-MM-DD",
      "example": "2026-07-15"
    },
    "dateFormatted": {
      "type": "string",
      "description": "Data por extenso em português",
      "example": "15 de Julho de 2026"
    },
    "category": {
      "type": "string",
      "description": "Nome da categoria científica",
      "example": "Balões Farmacológicos"
    },
    "categorySlug": {
      "type": "string",
      "enum": ["baloes", "estrutural", "coronaria", "jovem"],
      "description": "Slug de filtro da categoria"
    },
    "badge": {
      "type": "string",
      "description": "Texto em destaque no card",
      "example": "Lançamento Oficial"
    },
    "duration": {
      "type": "string",
      "description": "Duração estimada da gravação",
      "example": "1h 15m"
    },
    "thumbnail": {
      "type": "string",
      "format": "uri",
      "description": "URL da imagem de capa 16:9 em alta resolução"
    },
    "vimeoId": {
      "type": "string",
      "description": "ID numérico do vídeo no Vimeo",
      "example": "1223707542"
    },
    "videoEmbedUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL de incorporação do player"
    },
    "infographicUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL da imagem de infográfico em alta resolução"
    },
    "infographicTitle": {
      "type": "string",
      "description": "Legenda ou título do infográfico"
    },
    "pdfUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL de download do relatório ou material em PDF"
    },
    "pdfTitle": {
      "type": "string",
      "description": "Título legível do documento PDF"
    },
    "notebookLm": {
      "type": "object",
      "required": ["notebookUrl"],
      "properties": {
        "notebookUrl": { "type": "string", "format": "uri" },
        "quizUrl": { "type": "string", "format": "uri" },
        "flashcardsUrl": { "type": "string", "format": "uri" }
      }
    },
    "audios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "artist", "duration", "type", "desc"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "artist": { "type": "string" },
          "duration": { "type": "string", "example": "02:15" },
          "durationSec": { "type": "number", "example": 135 },
          "type": { "type": "string", "example": "Resumo em Áudio" },
          "desc": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Conteúdo HTML estilizado para a aba Resumo (suporta .webinar-lead, .webinar-callout, .webinar-highlights-grid)"
    },
    "fullReport": {
      "type": "string",
      "description": "Conteúdo HTML estilizado para a aba Relatório da Aula (suporta .webinar-comparison-table, tópicos e tabelas)"
    },
    "quiz": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "options", "correctIndex", "explanation"],
        "properties": {
          "question": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 5
          },
          "correctIndex": { "type": "integer", "minimum": 0, "maximum": 4 },
          "explanation": { "type": "string" }
        }
      }
    }
  }
}
